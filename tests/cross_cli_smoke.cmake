if(NOT EXISTS "${CAI_BINARY}" OR NOT CAI_RUNNER OR NOT CAI_EXPECTED_VERSION)
  message(FATAL_ERROR "CLI smoke requires the target binary, runner and version")
endif()
foreach(flag --version --help --cai-invalid-smoke-option)
  execute_process(COMMAND ${CAI_RUNNER} "${CAI_BINARY}" "${flag}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 2)
  if(flag STREQUAL "--cai-invalid-smoke-option")
    if(NOT "${result}" STREQUAL "2" OR diagnostic STREQUAL "")
      message(FATAL_ERROR "Invalid option must exit 2 with a diagnostic: ${result}: ${diagnostic}")
    endif()
  elseif(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "CLI ${flag} failed: ${result}: ${diagnostic}")
  elseif(flag STREQUAL "--version")
    string(STRIP "${output}" version)
    if(NOT version STREQUAL CAI_EXPECTED_VERSION)
      message(FATAL_ERROR "Wrong CLI version: ${output}")
    endif()
  elseif(NOT output MATCHES "Usage: cai")
    message(FATAL_ERROR "CLI help lacks its usage: ${output}")
  endif()
endforeach()
