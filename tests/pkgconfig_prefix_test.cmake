cmake_minimum_required(VERSION 3.21)
include("${CAI_SOURCE_DIR}/cmake/cai-pkgconfig.cmake")
find_program(PKG_CONFIG NAMES pkg-config REQUIRED)
set(root "${CAI_BINARY_DIR}/pkgconfig-prefix-test")
file(REMOVE_RECURSE "${root}")
set(CMAKE_INSTALL_INCLUDEDIR include)
set(CAI_PACKAGE_VERSION 1.0.0)
set(CAI_PSLOG_VERSION 1.0.0)
set(CAI_SOFTLINE_VERSION 1.0.0)
set(CAI_LIBMDF_VERSION 1.0.0)
set(CAI_LOCKDC_VERSION 1.0.0)
foreach(libdir IN ITEMS lib lib64 lib/x86_64-linux-gnu lib/a/b)
  set(CMAKE_INSTALL_LIBDIR "${libdir}")
  cai_pkgconfig_prefix_from_libdir("${libdir}" CAI_PC_PREFIX_FROM_PKGCONFIG)
  string(REPLACE "/" "-" name "${libdir}")
  set(prefix "${root}/${name}/relocated")
  set(pcdir "${prefix}/${libdir}/pkgconfig")
  file(MAKE_DIRECTORY "${pcdir}")
  configure_file("${CAI_SOURCE_DIR}/cmake/cai.pc.in" "${pcdir}/cai.pc" @ONLY)
  configure_file("${CAI_SOURCE_DIR}/cmake/cai-app.pc.in" "${pcdir}/cai-app.pc" @ONLY)
  # Dependency records supply no libraries: only CAI's installed paths are
  # under test. Real static/shared consumer linking is covered by app-install.
  foreach(dependency IN ITEMS pslog softline libmdf lockdc)
    file(WRITE "${pcdir}/${dependency}.pc"
      "Name: ${dependency}\nDescription: fixture\nVersion: 1.0.0\nLibs:\nCflags:\n")
  endforeach()
  foreach(package IN ITEMS cai cai-app)
    foreach(variable IN ITEMS prefix libdir includedir)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "PKG_CONFIG_PATH=${pcdir}" "PKG_CONFIG_LIBDIR=${pcdir}" "PKG_CONFIG_SYSROOT_DIR="
        "${PKG_CONFIG}" "--variable=${variable}" "${package}"
        RESULT_VARIABLE result OUTPUT_VARIABLE value ERROR_VARIABLE errors
        OUTPUT_STRIP_TRAILING_WHITESPACE)
      get_filename_component(actual "${value}" ABSOLUTE)
      set(expected "${prefix}")
      if(variable STREQUAL "libdir")
        string(APPEND expected "/${libdir}")
      elseif(variable STREQUAL "includedir")
        string(APPEND expected "/include")
      endif()
      if(NOT result EQUAL 0 OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "${package} ${variable} for ${libdir}: expected ${expected}, got ${value}: ${errors}")
      endif()
    endforeach()
  endforeach()
endforeach()
file(REMOVE_RECURSE "${root}")
