set(scratch "${CAI_BINARY_DIR}/yaml-producer-test")
file(REMOVE_RECURSE "${scratch}")
file(MAKE_DIRECTORY "${scratch}/deps")
file(COPY "${CAI_YAML_SOURCE}" DESTINATION "${scratch}/deps")
file(COPY "${CAI_ROOT}/cmake/libyaml" DESTINATION "${scratch}/wrapper")
file(COPY "${CAI_ROOT}/cmake/CaiYaml.cmake" DESTINATION "${scratch}/wrapper")
set(module "${scratch}/wrapper/CaiYaml.cmake")
set(arguments -G Ninja "-DCMAKE_C_COMPILER=${CAI_C_COMPILER}"
  "-DFIXTURE_DEPS=${scratch}/deps" "-DFIXTURE_ARCHIVE=${CAI_YAML_ARCHIVE}"
  "-DFIXTURE_MODULE=${module}" -DCMAKE_BUILD_TYPE=Debug)
if(CAI_TOOLCHAIN_FILE)
  list(APPEND arguments "-DCMAKE_TOOLCHAIN_FILE=${CAI_TOOLCHAIN_FILE}"
    "-DCPKT_TARGET_ID=${CAI_TARGET_ID}")
endif()
function(configure directory)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${CAI_ROOT}/tests/yaml_producer"
    -B "${directory}" ${arguments} ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Fixture configure failed: ${output}${error}")
  endif()
endfunction()
function(build directory)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${directory}" --parallel 1
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Fixture build failed: ${output}${error}")
  endif()
  set(build_output "${output}" PARENT_SCOPE)
endfunction()
function(run_consumer directory)
  execute_process(COMMAND "${directory}/consumer"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Native YAML consumer failed: ${output}${error}")
  endif()
endfunction()
configure("${scratch}/one")
file(READ "${scratch}/one/producer-path.txt" producer)
set(archive "${producer}/libyaml.a")
if(EXISTS "${archive}")
  message(FATAL_ERROR "Configuring a consumer compiled libyaml")
endif()
build("${scratch}/one")
run_consumer("${scratch}/one")
if(NOT EXISTS "${archive}" OR NOT EXISTS "${producer}/libyaml.so")
  message(FATAL_ERROR "Producer did not build both static and shared outputs")
endif()
file(TIMESTAMP "${archive}" initial "%s")
file(COPY "${scratch}/wrapper/" DESTINATION "${scratch}/second-wrapper")
configure("${scratch}/two" "-DFIXTURE_MODULE=${scratch}/second-wrapper/CaiYaml.cmake")
file(READ "${scratch}/two/producer-path.txt" second_producer)
if(NOT producer STREQUAL second_producer)
  message(FATAL_ERROR "Matching native consumers do not share a producer")
endif()
build("${scratch}/two")
run_consumer("${scratch}/two")
if(build_output MATCHES "Building C object.*yaml_objects")
  message(FATAL_ERROR "Matching consumer recompiled unchanged libyaml: ${build_output}")
endif()
file(TIMESTAMP "${archive}" reused "%s")
if(NOT initial STREQUAL reused)
  message(FATAL_ERROR "Unchanged archive was rewritten")
endif()
configure("${scratch}/one")
file(APPEND "${scratch}/deps/libyaml-0.2.5/src/api.c" "\n/* fixture source edit */\n")
build("${scratch}/one")
if(NOT build_output MATCHES "Building C object.*api.c")
  message(FATAL_ERROR "Native source change did not rebuild the producer")
endif()
file(APPEND "${scratch}/wrapper/libyaml/CMakeLists.txt"
  "\ntarget_compile_definitions(yaml_objects PRIVATE FIXTURE_WRAPPER_CHANGED)\n")
build("${scratch}/one")
if(NOT build_output MATCHES "Building C object.*yaml_objects")
  message(FATAL_ERROR "Producer wrapper change was not invalidated")
endif()
file(REMOVE "${archive}")
build("${scratch}/one")
if(NOT EXISTS "${archive}")
  message(FATAL_ERROR "Deleted producer byproduct was not rebuilt")
endif()
file(REMOVE "${producer}/libyaml.so.0.2.5")
build("${scratch}/one")
if(NOT EXISTS "${producer}/libyaml.so.0.2.5")
  message(FATAL_ERROR "Deleted shared producer byproduct was not rebuilt")
endif()
configure("${scratch}/asan" "-DCMAKE_C_FLAGS_DEBUG=-g -fsanitize=address,undefined -fno-omit-frame-pointer")
file(READ "${scratch}/asan/producer-path.txt" instrumented)
if(instrumented STREQUAL producer OR NOT instrumented MATCHES "sanitizer")
  message(FATAL_ERROR "ASan configuration borrowed the normal producer")
endif()
build("${scratch}/asan")
run_consumer("${scratch}/asan")
file(READ "${instrumented}/build.ninja" rules)
if(NOT rules MATCHES "-fsanitize=address,undefined")
  message(FATAL_ERROR "ASan flags were not propagated to libyaml")
endif()
configure("${scratch}/coverage" -DCAI_ENABLE_COVERAGE=ON)
file(READ "${scratch}/coverage/producer-path.txt" covered)
if(covered STREQUAL producer OR covered STREQUAL instrumented)
  message(FATAL_ERROR "Coverage borrowed another instrumentation producer")
endif()
build("${scratch}/coverage")
run_consumer("${scratch}/coverage")
file(READ "${covered}/build.ninja" rules)
if(NOT rules MATCHES "--coverage")
  message(FATAL_ERROR "Coverage flags were not propagated to libyaml")
endif()
