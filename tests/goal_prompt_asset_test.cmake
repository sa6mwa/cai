file(SHA256 "${CAI_SOURCE_DIR}/prompts/goal/codex-continuation.md" _baseline_hash)
if(NOT _baseline_hash STREQUAL "764b9c26b36013a21b687d74597e303be9bbf13776c359ec1fb185dbc0e7eac7")
  message(FATAL_ERROR "Codex goal continuation baseline changed")
endif()
file(READ "${CAI_SOURCE_DIR}/prompts/goal/codex-continuation.md" _baseline)
file(READ "${CAI_SOURCE_DIR}/prompts/goal/continuation.md" _template)
string(FIND "${_baseline}" "Progress visibility:\n" _plan_begin)
string(FIND "${_baseline}" "Fidelity:\n" _plan_end)
string(SUBSTRING "${_baseline}" 0 ${_plan_begin} _prefix)
string(SUBSTRING "${_baseline}" ${_plan_end} -1 _suffix)
set(_baseline "${_prefix}${_suffix}")
string(FIND "${_baseline}" "Call update_goal only after" _baseline_end)
string(FIND "${_template}" "Call update_goal with status" _template_end)
if(_baseline_end LESS 0 OR _template_end LESS 0)
  message(FATAL_ERROR "Missing goal lifecycle policy")
endif()
string(SUBSTRING "${_baseline}" 0 ${_baseline_end} _baseline)
string(SUBSTRING "${_template}" 0 ${_template_end} _prefix)
if(NOT _prefix STREQUAL _baseline)
  message(FATAL_ERROR "Goal objective, budget and continuation audits must match Codex")
endif()
file(READ "${CAI_BINARY_DIR}/generated/private/cai_goal_continuation.inc" _bytes)
string(REPLACE "0x" "" _bytes "${_bytes}")
string(REGEX REPLACE "[, \t\r\n]" "" _bytes "${_bytes}")
string(HEX "${_template}" _hex)
if(NOT _bytes STREQUAL "${_hex}00")
  message(FATAL_ERROR "Compiled goal prompt does not match its source")
endif()
