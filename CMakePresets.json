{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CAI_BUILD_STATIC": "ON",
        "CAI_BUILD_APP": "OFF",
        "CAI_BUILD_SHARED": "ON",
        "CAI_BUILD_TESTS": "ON",
        "CAI_BUILD_INTEGRATION_TESTS": "OFF",
        "CAI_BUILD_LUA": "OFF",
        "CAI_ENABLE_COVERAGE": "OFF",
        "CAI_INSTALL": "ON",
        "CAI_DEPENDENCY_MODE": "cpkt"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAI_BUILD_LUA": "OFF",
        "CAI_DIST_DIR": "${sourceDir}/dist"
      }
    },
    {
      "name": "bootlin-native",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-bootlin.cmake",
        "CPKT_TARGET_ID": "x86_64-linux-gnu",
        "CAI_TARGET_ID": "x86_64-linux-gnu"
      }
    },
    {
      "name": "native-lifecycle",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/native-lifecycle.cmake"
      }
    },
    {
      "name": "debug",
      "inherits": "native-lifecycle",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAI_BUILD_CLI": "OFF",
        "CAI_ENABLE_VALGRIND_TESTS": "ON"
      }
    },
    {
      "name": "debug-cai",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CAI_BUILD_CLI": "ON",
        "CAI_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "libcai",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CAI_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "cai",
      "inherits": "x86_64-linux-musl-release",
      "cacheVariables": {
        "CAI_BUILD_CLI": "ON",
        "CAI_BUILD_SHARED": "OFF",
        "CAI_BUILD_EXAMPLES": "OFF",
        "CAI_BUILD_LUA": "OFF",
        "CAI_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug-host-deps",
      "inherits": "debug",
      "cacheVariables": {
        "CAI_DEPENDENCY_MODE": "host"
      }
    },
    {
      "name": "debug-lua",
      "inherits": "debug",
      "cacheVariables": {
        "CAI_BUILD_LUA": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "bootlin-native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAI_BUILD_LUA": "OFF",
        "CAI_DIST_DIR": "${sourceDir}/dist",
        "CAI_TARGET_ID": "x86_64-linux-gnu"
      }
    },
    {
      "name": "x86_64-linux-gnu-release",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-bootlin.cmake",
        "CPKT_TARGET_ID": "x86_64-linux-gnu",
        "CAI_BUILD_APP": "ON"
      }
    },
    {
      "name": "x86_64-linux-musl-release",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-bootlin.cmake",
        "CPKT_TARGET_ID": "x86_64-linux-musl",
        "CAI_TARGET_ID": "x86_64-linux-musl",
        "CAI_BUILD_TESTS": "OFF",
        "CAI_BUILD_APP": "ON"
      }
    },
    {
      "name": "aarch64-linux-gnu-release",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-bootlin.cmake",
        "CPKT_TARGET_ID": "aarch64-linux-gnu",
        "CAI_TARGET_ID": "aarch64-linux-gnu",
        "CAI_BUILD_APP": "ON",
        "CAI_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "aarch64-linux-musl-release",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-bootlin.cmake",
        "CPKT_TARGET_ID": "aarch64-linux-musl",
        "CAI_TARGET_ID": "aarch64-linux-musl",
        "CAI_BUILD_APP": "ON",
        "CAI_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "armhf-linux-gnu-release",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-bootlin.cmake",
        "CPKT_TARGET_ID": "armhf-linux-gnu",
        "CAI_TARGET_ID": "armhf-linux-gnu",
        "CAI_BUILD_APP": "ON",
        "CAI_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "armhf-linux-musl-release",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-bootlin.cmake",
        "CPKT_TARGET_ID": "armhf-linux-musl",
        "CAI_TARGET_ID": "armhf-linux-musl",
        "CAI_BUILD_APP": "ON",
        "CAI_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "arm64-apple-darwin-release",
      "inherits": "release-base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/arm64-apple-darwin.cmake",
        "CAI_TARGET_ID": "arm64-apple-darwin",
        "CAI_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "asan",
      "inherits": "bootlin-native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "valgrind",
      "inherits": "debug",
      "cacheVariables": {
        "CAI_ENABLE_VALGRIND_TESTS": "ON"
      },
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-aflpp.cmake",
        "CPKT_TARGET_ID": "x86_64-linux-gnu",
        "CAI_TARGET_ID": "x86_64-linux-gnu",
        "CAI_BUILD_FUZZERS": "ON",
        "CAI_BUILD_TESTS": "OFF",
        "CAI_BUILD_EXAMPLES": "OFF",
        "CAI_BUILD_SHARED": "OFF"
      }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "cacheVariables": {
        "CAI_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "integration",
      "inherits": "debug",
      "cacheVariables": {
        "CAI_BUILD_INTEGRATION_TESTS": "ON",
        "CAI_BUILD_LUA": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 4
    },
    {
      "name": "libcai",
      "configurePreset": "libcai",
      "jobs": 4
    },
    {
      "name": "cai",
      "configurePreset": "cai",
      "jobs": 4
    },
    {
      "name": "debug-host-deps",
      "configurePreset": "debug-host-deps",
      "jobs": 4
    },
    {
      "name": "debug-lua",
      "configurePreset": "debug-lua",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    },
    {
      "name": "x86_64-linux-gnu-release",
      "configurePreset": "x86_64-linux-gnu-release",
      "jobs": 4
    },
    {
      "name": "x86_64-linux-musl-release",
      "configurePreset": "x86_64-linux-musl-release",
      "jobs": 4
    },
    {
      "name": "aarch64-linux-gnu-release",
      "configurePreset": "aarch64-linux-gnu-release",
      "jobs": 4
    },
    {
      "name": "aarch64-linux-musl-release",
      "configurePreset": "aarch64-linux-musl-release",
      "jobs": 4
    },
    {
      "name": "armhf-linux-gnu-release",
      "configurePreset": "armhf-linux-gnu-release",
      "jobs": 4
    },
    {
      "name": "armhf-linux-musl-release",
      "configurePreset": "armhf-linux-musl-release",
      "jobs": 4
    },
    {
      "name": "arm64-apple-darwin-release",
      "configurePreset": "arm64-apple-darwin-release",
      "jobs": 4
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "jobs": 4
    },
    {
      "name": "valgrind",
      "configurePreset": "valgrind",
      "jobs": 4
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "jobs": 4
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "jobs": 4
    },
    {
      "name": "integration",
      "configurePreset": "integration",
      "jobs": 4
    },
    {
      "name": "debug-cai",
      "configurePreset": "debug-cai",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "libcai",
      "configurePreset": "libcai",
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cai",
      "configurePreset": "cai",
      "filter": {
        "include": {
          "name": "^cai_cli_"
        }
      },
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-host-deps",
      "configurePreset": "debug-host-deps",
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-lua",
      "configurePreset": "debug-lua",
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "valgrind",
      "configurePreset": "valgrind",
      "filter": {
        "include": {
          "label": "^valgrind$"
        }
      },
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "integration",
      "configurePreset": "integration",
      "filter": {
        "include": {
          "label": "integration"
        }
      },
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-cai",
      "configurePreset": "debug-cai",
      "filter": {
        "include": {
          "name": "^cai_(cli_|app)"
        }
      },
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "filter": {
        "include": {
          "label": "^fuzz$"
        }
      },
      "execution": {
        "stopOnFailure": true,
        "jobs": 1,
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
