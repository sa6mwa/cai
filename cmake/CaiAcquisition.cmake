# One checksum-pinned archive acquisition surface for SDKs and source producers.
function(cai_dependency_archive_path name sha256 output)
  string(LENGTH "${sha256}" length)
  if(NOT length EQUAL 64 OR NOT sha256 MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Missing/invalid SHA256 pin for ${name}")
  endif()
  set(${output} "${CPKT_DEPENDENCY_CACHE}/archives/sha256/${sha256}/${name}" PARENT_SCOPE)
endfunction()
function(cai_acquire_archive name url archive sha256)
  string(LENGTH "${sha256}" length)
  if(NOT length EQUAL 64 OR NOT sha256 MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Missing/invalid SHA256 pin for ${name}")
  endif()
  get_filename_component(directory "${archive}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}" "${CPKT_DEPENDENCY_CACHE}/locks")
  file(LOCK "${CPKT_DEPENDENCY_CACHE}/locks/${sha256}.lock" GUARD FUNCTION TIMEOUT 600)
  set(verified FALSE)
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" actual)
    if(actual STREQUAL sha256)
      set(verified TRUE)
    else()
      message(WARNING "Discarding corrupt ${name} archive (${archive})")
      file(REMOVE "${archive}")
    endif()
  endif()
  if(NOT verified)
    set(temporary "${archive}.tmp")
    foreach(attempt RANGE 1 3)
      file(REMOVE "${temporary}")
      file(DOWNLOAD "${url}" "${temporary}" TLS_VERIFY ON TIMEOUT 180
        INACTIVITY_TIMEOUT 15 STATUS result)
      list(GET result 0 code)
      list(GET result 1 detail)
      if(code EQUAL 0)
        file(SHA256 "${temporary}" actual)
        if(NOT actual STREQUAL sha256)
          file(REMOVE "${temporary}")
          message(FATAL_ERROR "${name} SHA256 mismatch: expected ${sha256}, got ${actual}")
        endif()
        file(RENAME "${temporary}" "${archive}")
        set(verified TRUE)
        break()
      endif()
      if(attempt LESS 3)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
      endif()
    endforeach()
    if(NOT verified)
      file(REMOVE "${temporary}")
      message(FATAL_ERROR "Download ${name} failed: ${detail} (${url})")
    endif()
  endif()
endfunction()

function(cai_download_tarball name url archive prefix sha256 marker)
  cai_acquire_archive("${name}" "${url}" "${archive}" "${sha256}")
  file(MAKE_DIRECTORY "${CAI_DEPS_DIR}")
  if(NOT EXISTS "${marker}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xzf "${archive}"
      WORKING_DIRECTORY "${CAI_DEPS_DIR}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT EXISTS "${marker}")
      message(FATAL_ERROR "${name} extraction failed or expected payload is missing: ${marker}")
    endif()
  endif()
endfunction()
