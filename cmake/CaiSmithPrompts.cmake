set(_cai_manifest_path "${CMAKE_CURRENT_SOURCE_DIR}/prompts/smith/manifest.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_cai_manifest_path}")
file(READ "${_cai_manifest_path}" _cai_manifest)
string(JSON _cai_count LENGTH "${_cai_manifest}" profiles)
string(JSON _cai_fallback GET "${_cai_manifest}" fallback_profile)
math(EXPR _cai_last "${_cai_count} - 1")
set(_cai_registry "")
set(_cai_entries "static const cai_smith_prompt_entry cai_smith_prompt_entries[] = {\n")
set(CAI_SMITH_PROMPT_INC_PATHS "")
set(_cai_fallback_symbol "")
foreach(_cai_index RANGE ${_cai_last})
  string(JSON _cai_name GET "${_cai_manifest}" profiles ${_cai_index} name)
  if(NOT _cai_name MATCHES "^[a-z0-9][a-z0-9._-]*$")
    message(FATAL_ERROR "Invalid Smith prompt profile name")
  endif()
  string(REGEX REPLACE "[.-]" "_" _cai_symbol "cai_smith_${_cai_name}_prompt")
  foreach(_cai_kind source template)
    string(JSON _cai_asset GET "${_cai_manifest}" profiles ${_cai_index} ${_cai_kind} asset)
    string(JSON _cai_expected_hash GET "${_cai_manifest}" profiles ${_cai_index} ${_cai_kind} sha256)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${_cai_asset}" _cai_hash)
    if(NOT _cai_hash STREQUAL _cai_expected_hash)
      message(FATAL_ERROR "Smith prompt ${_cai_asset} does not match its pinned hash")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${_cai_asset}")
  endforeach()
  set(_cai_template "${CMAKE_CURRENT_SOURCE_DIR}/${_cai_asset}")
  set(_cai_inc "${CAI_SMITH_PRIVATE_INCLUDE_DIR}/${_cai_symbol}.inc")
  add_custom_command(OUTPUT "${_cai_inc}"
    COMMAND "${CMAKE_COMMAND}" "-DCAI_ASSET_INPUT=${_cai_template}"
      "-DCAI_ASSET_OUTPUT=${_cai_inc}" -DCAI_ASSET_MODE=c-string
      -P "${CAI_SMITH_PROMPT_GENERATOR}"
    DEPENDS "${_cai_template}" "${CAI_SMITH_PROMPT_GENERATOR}" VERBATIM)
  list(APPEND CAI_SMITH_PROMPT_INC_PATHS "${_cai_inc}")
  string(APPEND _cai_registry "static const unsigned char ${_cai_symbol}[] = {\n#include \"${_cai_symbol}.inc\"\n};\n")
  string(JSON _cai_models LENGTH "${_cai_manifest}" profiles ${_cai_index} models)
  math(EXPR _cai_model_last "${_cai_models} - 1")
  foreach(_cai_model_index RANGE ${_cai_model_last})
    string(JSON _cai_model GET "${_cai_manifest}" profiles ${_cai_index} models ${_cai_model_index})
    if(NOT _cai_model MATCHES "^[a-z0-9][a-z0-9._-]*$")
      message(FATAL_ERROR "Invalid Smith prompt model name")
    endif()
    string(APPEND _cai_entries "  {\"${_cai_model}\", ${_cai_symbol}},\n")
  endforeach()
  if(_cai_name STREQUAL _cai_fallback)
    set(_cai_fallback_symbol "${_cai_symbol}")
  endif()
endforeach()
if(_cai_fallback_symbol STREQUAL "")
  message(FATAL_ERROR "Smith prompt fallback profile is missing")
endif()
string(APPEND _cai_registry "${_cai_entries}};\nstatic const unsigned char *const cai_smith_fallback_prompt = ${_cai_fallback_symbol};\n")
file(GENERATE OUTPUT "${CAI_SMITH_PRIVATE_INCLUDE_DIR}/cai_smith_prompt_catalog.inc" CONTENT "${_cai_registry}")
