set(PACKAGE_VERSION "@CAI_PACKAGE_VERSION@")

set(PACKAGE_VERSION_EXACT FALSE)
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_UNSUITABLE FALSE)

set(_cai_package_version_numeric "@CAI_CMAKE_PROJECT_VERSION@")
set(_cai_package_version_major "@PROJECT_VERSION_MAJOR@")
set(_cai_package_is_prerelease FALSE)
if(PACKAGE_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+-")
  set(_cai_package_is_prerelease TRUE)
endif()

if(NOT PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  set(_cai_package_at_least_requested TRUE)
elseif(_cai_package_version_numeric VERSION_LESS PACKAGE_FIND_VERSION)
  set(_cai_package_at_least_requested FALSE)
elseif(_cai_package_is_prerelease AND
       _cai_package_version_numeric VERSION_EQUAL PACKAGE_FIND_VERSION AND
       NOT PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
  set(_cai_package_at_least_requested FALSE)
else()
  set(_cai_package_at_least_requested TRUE)
endif()

if(NOT PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(NOT _cai_package_at_least_requested)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  if(PACKAGE_FIND_VERSION_RANGE)
    math(EXPR _cai_package_version_major_next
         "${_cai_package_version_major} + 1")
    set(_cai_range_major_ok TRUE)
    if(NOT PACKAGE_FIND_VERSION_MIN_MAJOR STREQUAL
       _cai_package_version_major)
      set(_cai_range_major_ok FALSE)
    elseif(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE" AND
           NOT PACKAGE_FIND_VERSION_MAX_MAJOR STREQUAL
               _cai_package_version_major)
      set(_cai_range_major_ok FALSE)
    elseif(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE" AND
           NOT PACKAGE_FIND_VERSION_MAX VERSION_LESS_EQUAL
               _cai_package_version_major_next)
      set(_cai_range_major_ok FALSE)
    endif()

    set(_cai_range_upper_ok FALSE)
    if(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE")
      if(_cai_package_version_numeric VERSION_LESS_EQUAL
         PACKAGE_FIND_VERSION_MAX)
        set(_cai_range_upper_ok TRUE)
      endif()
    elseif(_cai_package_version_numeric VERSION_LESS
           PACKAGE_FIND_VERSION_MAX)
      set(_cai_range_upper_ok TRUE)
    endif()

    if(_cai_range_major_ok AND _cai_range_upper_ok)
      set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
  else()
    if(PACKAGE_FIND_VERSION_MAJOR STREQUAL _cai_package_version_major)
      set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()

    if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
      set(PACKAGE_VERSION_EXACT TRUE)
      set(PACKAGE_VERSION_COMPATIBLE TRUE)
    elseif(NOT _cai_package_is_prerelease AND
           PACKAGE_FIND_VERSION STREQUAL _cai_package_version_numeric)
      set(PACKAGE_VERSION_EXACT TRUE)
      set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
  endif()
endif()

if("${CMAKE_SIZEOF_VOID_P}" STREQUAL "" OR "@CMAKE_SIZEOF_VOID_P@" STREQUAL "")
  return()
endif()

if(NOT CMAKE_SIZEOF_VOID_P STREQUAL "@CMAKE_SIZEOF_VOID_P@")
  math(EXPR _cai_installed_bits "@CMAKE_SIZEOF_VOID_P@ * 8")
  set(PACKAGE_VERSION "${PACKAGE_VERSION} (${_cai_installed_bits}bit)")
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()

unset(_cai_installed_bits)
unset(_cai_package_at_least_requested)
unset(_cai_package_is_prerelease)
unset(_cai_package_version_major)
unset(_cai_package_version_major_next)
unset(_cai_package_version_numeric)
unset(_cai_range_major_ok)
unset(_cai_range_upper_ok)
