# Never remove a prepared/shared cache through an owned generated ancestor.
if(NOT DEFINED ROOT OR ROOT STREQUAL "/" OR ROOT STREQUAL "")
  message(FATAL_ERROR "A concrete owning checkout is required")
endif()
set(caches "$ENV{CPKT_DEPENDENCY_CACHE}" "$ENV{CPKT_TOOLCHAIN_CACHE}")
file(GLOB build_caches "${ROOT}/build/*/CMakeCache.txt")
foreach(cache IN LISTS build_caches)
  file(STRINGS "${cache}" values REGEX "^CPKT_(DEPENDENCY|TOOLCHAIN)_CACHE:PATH=")
  foreach(value IN LISTS values)
    string(REGEX REPLACE "^[^=]*=" "" value "${value}")
    list(APPEND caches "${value}")
  endforeach()
endforeach()
foreach(cache IN LISTS caches)
  if(cache STREQUAL "")
    continue()
  endif()
  cmake_path(ABSOLUTE_PATH cache BASE_DIRECTORY "${ROOT}" NORMALIZE OUTPUT_VARIABLE absolute)
  foreach(owned build dist .cache)
    string(FIND "${absolute}/" "${ROOT}/${owned}/" prefix)
    if(prefix EQUAL 0)
      message(FATAL_ERROR "Prepared/shared cache overlaps disposable ${owned}: ${absolute}; select an external cache before cleaning")
    endif()
  endforeach()
endforeach()
