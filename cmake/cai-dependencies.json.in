{
  "schemaVersion": 1,
  "project": "cai",
  "version": "@CAI_PACKAGE_VERSION@",
  "targetId": "@CAI_TARGET_ID@",
  "dependencyMode": "@CAI_RESOLVED_DEPENDENCY_MODE@",
  "dependencies": [
    {
      "name": "libyaml",
      "version": "@CAI_LIBYAML_VERSION@",
      "targetId": "@CAI_TARGET_ID@",
      "sourceSystem": "cpktmisc-component",
      "providedBy": "cpktmisc",
      "licenseIdentifier": "MIT",
      "bundled": true,
      "installRole": "embedded-static-parser"
    },
    {
      "name": "cpktmisc",
      "packageId": "@CAI_CPKTMISC_PACKAGE_ID_FOR_PACKAGE@",
      "version": "@CAI_CPKTMISC_VERSION@",
      "targetId": "@CAI_TARGET_ID@",
      "sourceSystem": "github-release",
      "sourceUrl": "@CAI_CPKTMISC_URL_FOR_PACKAGE@",
      "sha256": "@CAI_CPKTMISC_SHA256_FOR_PACKAGE@",
      "archiveName": "@CAI_CPKTMISC_ARCHIVE_NAME_FOR_PACKAGE@",
      "licenseIdentifier": "NOASSERTION",
      "bundled": false,
      "installRole": "external-static-consumer-sdk"
    },
    {
      "name": "cpkt",
      "packageId": "@CAI_CPKT_PACKAGE_ID_FOR_PACKAGE@",
      "version": "@CAI_CPKT_VERSION@",
      "targetId": "@CAI_TARGET_ID@",
      "sourceSystem": "github-release",
      "sourceUrl": "@CAI_CPKT_URL_FOR_PACKAGE@",
      "sha256": "@CAI_CPKT_SHA256_FOR_PACKAGE@",
      "archiveName": "@CAI_CPKT_ARCHIVE_NAME_FOR_PACKAGE@",
      "licenseIdentifier": "NOASSERTION",
      "bundled": false,
      "installRole": "external-static-consumer-sdk"
    },
    {
      "name": "lonejson",
      "version": "@CAI_LONEJSON_VERSION@",
      "targetId": "@CAI_TARGET_ID@",
      "sourceSystem": "github-release",
      "sourceUrl": "@CAI_LONEJSON_PKG_URL_FOR_PACKAGE@",
      "sha256": "@CAI_LONEJSON_PKG_SHA256_FOR_PACKAGE@",
      "archiveName": "@CAI_LONEJSON_ARCHIVE_NAME_FOR_PACKAGE@",
      "licenseIdentifier": "NOASSERTION",
      "bundled": false,
      "installRole": "public-link-interface"
    },
    {
      "name": "libpslog",
      "version": "@CAI_PSLOG_VERSION@",
      "targetId": "@CAI_TARGET_ID@",
      "sourceSystem": "github-release",
      "sourceUrl": "@CAI_PSLOG_PKG_URL_FOR_PACKAGE@",
      "sha256": "@CAI_PSLOG_PKG_SHA256_FOR_PACKAGE@",
      "archiveName": "@CAI_PSLOG_ARCHIVE_NAME_FOR_PACKAGE@",
      "licenseIdentifier": "NOASSERTION",
      "bundled": false,
      "installRole": "public-header-logger-api"
    }
  ]
}
