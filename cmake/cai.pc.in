prefix=${pcfiledir}/@CAI_PC_PREFIX_FROM_PKGCONFIG@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
cpkt_version=@CAI_CPKT_VERSION@
cpkt_target=@CAI_TARGET_ID@
cpkt_url=https://github.com/c89systems/cpkt/releases/download/v@CAI_CPKT_VERSION@/cpkt-@CAI_CPKT_VERSION@-@CAI_TARGET_ID@.tar.gz
cpkt_sha256=@CAI_CPKT_SHA256_FOR_PACKAGE@
cpkt_package_id=@CAI_CPKT_PACKAGE_ID_FOR_PACKAGE@
dependency_mode=@CAI_RESOLVED_DEPENDENCY_MODE@
lonejson_version=@CAI_LONEJSON_VERSION@
lonejson_abi_version=@CAI_LONEJSON_ABI_VERSION@
lonejson_target=@CAI_TARGET_ID@
lonejson_url=https://github.com/sa6mwa/lonejson/releases/download/v@CAI_LONEJSON_VERSION@/liblonejson-@CAI_LONEJSON_VERSION@-@CAI_TARGET_ID@.tar.gz
lonejson_sha256=@CAI_LONEJSON_PKG_SHA256_FOR_PACKAGE@

Name: cai
Description: C89/POSIX SDK client for the OpenAI Responses API
Version: @CAI_PACKAGE_VERSION@
Libs: -L${libdir} -lcai
Libs.private: -pthread @CAI_PC_DEPENDENCY_LIBS_PRIVATE@
Requires: @CAI_PACKAGE_REQUIRES@
Requires.private: @CAI_PACKAGE_REQUIRES_PRIVATE@
Cflags: -I${includedir} @CAI_PC_DEPENDENCY_CFLAGS@
