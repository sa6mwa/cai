foreach(required ROOT OUTPUT SERVICE POD IMAGE PORT URL UID GID SECRET)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing development manifest field: ${required}")
  endif()
endforeach()
if(NOT SERVICE MATCHES "^(mcp-everything|searxng|inspector)$")
  message(FATAL_ERROR "Unknown development service")
endif()
set(STATE "${ROOT}/build/devenv/state/${SERVICE}")
set(TMP "${ROOT}/build/devenv/tmp/${SERVICE}")
set(CONFIG "${ROOT}/devenv/searxng")
foreach(field POD IMAGE URL STATE TMP CONFIG SECRET)
  string(REPLACE "\\" "\\\\" ${field} "${${field}}")
  string(REPLACE "\"" "\\\"" ${field} "${${field}}")
  string(REPLACE "\n" "\\n" ${field} "${${field}}")
  string(REPLACE "\r" "\\r" ${field} "${${field}}")
  set(${field} "\"${${field}}\"")
endforeach()
file(READ "${ROOT}/devenv.yaml.in" template)
string(FIND "${template}" "# service: ${SERVICE}\n" begin)
if(begin LESS 0)
  message(FATAL_ERROR "Service is missing from tracked template")
endif()
string(SUBSTRING "${template}" ${begin} -1 document)
string(FIND "${document}" "\n---\n" end)
if(NOT end LESS 0)
  string(SUBSTRING "${document}" 0 ${end} document)
endif()
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${document}\n" @ONLY)
file(CHMOD "${OUTPUT}" PERMISSIONS OWNER_READ OWNER_WRITE)
