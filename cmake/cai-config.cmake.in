@PACKAGE_INIT@
set(_cai_yaml_archive "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cai/@CMAKE_STATIC_LIBRARY_PREFIX@yaml@CMAKE_STATIC_LIBRARY_SUFFIX@")

include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/CaiLonejsonAbi.cmake")
set(cai_DEPENDENCY_MODE "@CAI_RESOLVED_DEPENDENCY_MODE@")
set(cai_LONEJSON_VERSION "@CAI_LONEJSON_VERSION@")
set(cai_LONEJSON_ABI_VERSION "@CAI_LONEJSON_ABI_VERSION@")
set(cai_LONEJSON_TARGET "@CAI_TARGET_ID@")
set(cai_LONEJSON_URL
    "https://github.com/sa6mwa/lonejson/releases/download/v@CAI_LONEJSON_VERSION@/liblonejson-@CAI_LONEJSON_VERSION@-@CAI_TARGET_ID@.tar.gz")
set(cai_LONEJSON_SHA256 "@CAI_LONEJSON_PKG_SHA256_FOR_PACKAGE@")
set(cai_CPKT_VERSION "@CAI_CPKT_VERSION@")
set(cai_CPKT_TARGET "@CAI_TARGET_ID@")
set(cai_CPKT_URL
    "https://github.com/c89systems/cpkt/releases/download/v@CAI_CPKT_VERSION@/cpkt-@CAI_CPKT_VERSION@-@CAI_TARGET_ID@.tar.gz")
set(cai_CPKT_SHA256 "@CAI_CPKT_SHA256_FOR_PACKAGE@")
set(cai_CPKT_PACKAGE_ID "@CAI_CPKT_PACKAGE_ID_FOR_PACKAGE@")

if(cai_DEPENDENCY_MODE STREQUAL "cpkt")
  find_dependency(CpktCore @CAI_MINIMUM_CPKT_VERSION@ CONFIG)
  if(NOT CpktCore_TARGET_ID STREQUAL cai_CPKT_TARGET)
    set(cai_FOUND FALSE)
    set(cai_NOT_FOUND_MESSAGE
        "cai requires cpkt target ${cai_CPKT_TARGET}, found ${CpktCore_TARGET_ID}")
    return()
  endif()
endif()

find_dependency(CURL @CAI_MINIMUM_CURL_VERSION@)
find_dependency(OpenSSL COMPONENTS Crypto)
find_dependency(Threads)
find_package(lonejson CONFIG QUIET COMPONENTS curl oidc openssl)
find_package(pslog CONFIG QUIET)

if(NOT TARGET cai::yaml_static)
  add_library(cai::yaml_static STATIC IMPORTED)
  set_target_properties(cai::yaml_static PROPERTIES
    IMPORTED_LOCATION "${_cai_yaml_archive}")
endif()
unset(_cai_yaml_archive)

include("${CMAKE_CURRENT_LIST_DIR}/cai-targets.cmake")

set(_cai_dependency_includes "")
if(TARGET lonejson::lonejson)
  get_target_property(cai_LONEJSON_INCLUDE_DIR lonejson::lonejson
                      INTERFACE_INCLUDE_DIRECTORIES)
  cai_get_imported_target_location(lonejson::lonejson cai_LONEJSON_LIBRARY)
else()
  find_library(cai_LONEJSON_LIBRARY NAMES lonejson
               HINTS "@CAI_CONFIG_LONEJSON_LIBRARY_HINT@")
  find_path(cai_LONEJSON_INCLUDE_DIR lonejson.h
            HINTS "@CAI_CONFIG_LONEJSON_INCLUDE_HINT@")
  if(cai_LONEJSON_INCLUDE_DIR AND cai_LONEJSON_LIBRARY)
    add_library(lonejson::lonejson UNKNOWN IMPORTED)
    set_target_properties(lonejson::lonejson PROPERTIES
      IMPORTED_LOCATION "${cai_LONEJSON_LIBRARY}"
      INTERFACE_INCLUDE_DIRECTORIES "${cai_LONEJSON_INCLUDE_DIR}")
  elseif(cai_LONEJSON_LIBRARY)
    add_library(lonejson::lonejson UNKNOWN IMPORTED)
    set_target_properties(lonejson::lonejson PROPERTIES
      IMPORTED_LOCATION "${cai_LONEJSON_LIBRARY}")
  endif()
endif()
if(NOT TARGET lonejson::lonejson)
  message(FATAL_ERROR
    "cai requires external liblonejson at build and runtime. "
    "Install liblonejson with ABI ${cai_LONEJSON_ABI_VERSION} and make "
    "either its CMake package or liblonejson discoverable. Official package: "
    "${cai_LONEJSON_URL}. "
    "For the native curl/OpenSSL stack, use ${cai_CPKT_URL}.")
endif()
cai_validate_lonejson_library_abi(
  "${cai_LONEJSON_LIBRARY}" "${cai_LONEJSON_ABI_VERSION}"
  "cai installed package")
if(cai_LONEJSON_INCLUDE_DIR)
  list(APPEND _cai_dependency_includes "${cai_LONEJSON_INCLUDE_DIR}")
endif()

foreach(_cai_target cai::cai_static cai::cai_shared)
  if(TARGET "${_cai_target}" AND _cai_dependency_includes)
    set_property(TARGET "${_cai_target}" APPEND PROPERTY
      INTERFACE_INCLUDE_DIRECTORIES "${_cai_dependency_includes}")
  endif()
endforeach()
if(TARGET cai::cai_shared AND TARGET lonejson::lonejson)
  set_property(TARGET cai::cai_shared APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES lonejson::lonejson)
endif()
unset(_cai_target)
unset(_cai_dependency_includes)
